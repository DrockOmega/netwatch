# ja3_blocklist.json IS committed (the curated/seedable known-bad fingerprint list).

# oui_db.json IS committed: it is generated from the public, freely-redistributable
# IEEE OUI registry (tools/refresh_oui_db.py), not licensed third-party data.

# --- Logs (rotating, per-process) ---
logs/

# --- Config overlays ---
# An overlay names a specific machine's NIC, delegated IPv6 prefix, and paths, so
# it is local state, not source. netwatch.config.example.json documents the shape
# and IS committed. Force-add an overlay (git add -f) if you deliberately want one
# tracked for a shared host.
netwatch.*.json
!netwatch.config.example.json

# --- Licensed third-party data: DO NOT COMMIT ---
# MaxMind's GeoLite2 license prohibits redistribution. Each user downloads their
# own copy (see README "GeoIP data"). Keeping it out of git avoids a license
# violation in a public portfolio repo.
GeoLite2-Country.mmdb
*.mmdb
telemetry_response_mode.json

# --- Local review/audit tool output ---
.audit/

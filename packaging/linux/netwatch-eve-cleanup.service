[Unit]
Description=Delete Suricata EVE files untouched for 3 days
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=suricata
Group=suricata
Environment=TZ=UTC
EnvironmentFile=-/etc/netwatch/sensor.env
UMask=0027
Nice=10
Environment=HOME=/var/lib/suricata
StateDirectory=suricata
StateDirectoryMode=0750
ReadWritePaths=/var/lib/suricata
ExecStart=/usr/bin/find /var/lib/suricata -maxdepth 1 -name 'eve.json*' -type f -mmin +4320 -delete
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

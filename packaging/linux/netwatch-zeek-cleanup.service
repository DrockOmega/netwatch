[Unit]
Description=Delete Zeek logs untouched for 3 days
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zeek
Group=zeek
UMask=0027
Nice=10
Environment=HOME=/var/lib/zeek
StateDirectory=zeek zeek/logs
StateDirectoryMode=0750
ReadWritePaths=/var/lib/zeek
ExecStart=/usr/bin/find /var/lib/zeek/logs -maxdepth 1 -name '*.log' -type f -mmin +4320 -delete
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
